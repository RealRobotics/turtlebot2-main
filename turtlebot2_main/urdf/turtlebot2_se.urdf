<?xml version="1.0"?>
<!-- This URDF file describes the TurtleBot2 robot with an Astra camera.
    It is a very basic model and is intended for use in simulation and visualization.
-->
<robot name="turtlebot2_astra">
  <material name="dark_grey"><color rgba="0.2 0.2 0.2 1.0"/></material>
  <material name="black"><color rgba="0.05 0.05 0.05 1.0"/></material>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.177" length="0.09"/></geometry>
      <material name="dark_grey"/>
    </visual>
  </link>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.04 0.165 0.04"/></geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="footprint_to_base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>

  <joint name="base_to_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.16 0 0.17" rpy="0 0 0"/>
  </joint>
</robot>
