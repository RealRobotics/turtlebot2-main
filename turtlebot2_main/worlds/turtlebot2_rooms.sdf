<?xml version="1.0"?>
<!-- Two-room test world: 10 x 8 m outer walls, two doorways and several obstacles. -->
<sdf version="1.9">
  <world name="turtlebot2_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>0 4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.15 0.15 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10.15 0.15 1.0</size></box></geometry>
          <material><ambient>0.75 0.75 0.7 1</ambient><diffuse>0.75 0.75 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.15 0.15 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10.15 0.15 1.0</size></box></geometry>
          <material><ambient>0.75 0.75 0.7 1</ambient><diffuse>0.75 0.75 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 8.15 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 8.15 1.0</size></box></geometry>
          <material><ambient>0.75 0.75 0.7 1</ambient><diffuse>0.75 0.75 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 8.15 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 8.15 1.0</size></box></geometry>
          <material><ambient>0.75 0.75 0.7 1</ambient><diffuse>0.75 0.75 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="divider_a_south">
      <static>true</static>
      <pose>-1.5 -2.3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 3.4 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 3.4 1.0</size></box></geometry>
          <material><ambient>0.75 0.75 0.7 1</ambient><diffuse>0.75 0.75 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="divider_a_north">
      <static>true</static>
      <pose>-1.5 2.3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 3.4 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 3.4 1.0</size></box></geometry>
          <material><ambient>0.75 0.75 0.7 1</ambient><diffuse>0.75 0.75 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="divider_b_west">
      <static>true</static>
      <pose>0.25 1 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3.5 0.15 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>3.5 0.15 1.0</size></box></geometry>
          <material><ambient>0.75 0.75 0.7 1</ambient><diffuse>0.75 0.75 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="divider_b_east">
      <static>true</static>
      <pose>4.1 1 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.8 0.15 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.8 0.15 1.0</size></box></geometry>
          <material><ambient>0.75 0.75 0.7 1</ambient><diffuse>0.75 0.75 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="box_1">
      <static>true</static>
      <pose>1.0 -2.0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.6</size></box></geometry>
          <material><ambient>0.3 0.45 0.7 1</ambient><diffuse>0.3 0.45 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="box_2">
      <static>true</static>
      <pose>-3.0 2.2 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 1.0 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.4 1.0 0.6</size></box></geometry>
          <material><ambient>0.3 0.45 0.7 1</ambient><diffuse>0.3 0.45 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="box_3">
      <static>true</static>
      <pose>2.5 2.8 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.4 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.4 0.6</size></box></geometry>
          <material><ambient>0.3 0.45 0.7 1</ambient><diffuse>0.3 0.45 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pillar_1">
      <static>true</static>
      <pose>3.5 -2.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.7 0.35 0.3 1</ambient><diffuse>0.7 0.35 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pillar_2">
      <static>true</static>
      <pose>-3.5 -2.0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.7 0.35 0.3 1</ambient><diffuse>0.7 0.35 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pillar_3">
      <static>true</static>
      <pose>0.5 -0.2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.15</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.15</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.7 0.35 0.3 1</ambient><diffuse>0.7 0.35 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
